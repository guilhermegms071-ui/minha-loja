# ── Flask ──────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=flamengo
BASE_URL=https://seudominio.com.br

# ── Banco de dados ─────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@db:5432/whatsapp_bling

# ── Bling API v3 (OAuth2) ──────────────────────────────
# Criado em developer.bling.com.br > Aplicativos
BLING_CLIENT_ID=
# Também usado pra validar a assinatura dos webhooks recebidos em
# /bling/webhook (header X-Bling-Signature-256) — não precisa de um
# segredo separado pra isso, é o mesmo Client Secret do app.
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=${BASE_URL}/bling/callback
BLING_API_BASE=https://bling.com.br/Api/v3

# ── WhatsApp Business Cloud API (Meta) ─────────────────
# Criado em developers.facebook.com > App > WhatsApp
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=um-token-qualquer-que-voce-inventa-para-validar-o-webhook
META_APP_SECRET=

# ── Evolution API (gateway self-hosted) ────────────────
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=troque-isso
EVOLUTION_INSTANCE_NAME=jsvcell

# ── Chatwoot (fila humana) ─────────────────────────────
CHATWOOT_URL=http://chatwoot:3000
# Perfil > Access Token, no painel do Chatwoot.
CHATWOOT_API_TOKEN=
# Aparece na URL do painel: app.chatwoot.com/app/accounts/{ACCOUNT_ID}/...
CHATWOOT_ACCOUNT_ID=
# Configurações > Inboxes > o inbox tipo "API" criado pra essa integração —
# use o ID numérico do inbox (não o "Inbox Identifier", que é outra coisa,
# usada só pela API pública/widget).
CHATWOOT_INBOX_ID=
# Configurações > Integrações > Webhooks > editar o webhook criado — o
# segredo aparece na tela de edição. Usado pra validar X-Chatwoot-Signature
# em /webhook/chatwoot; sem isso, o webhook é sempre recusado (401).
CHATWOOT_WEBHOOK_SECRET=

# ── Typebot (fluxo/menu) ───────────────────────────────
TYPEBOT_URL=http://typebot-builder:3001
TYPEBOT_VIEWER_URL=http://typebot-viewer:3002

# ── Regras de sincronização ─────────────────────────────
# Rede de segurança — o webhook em tempo real (/bling/webhook) cobre a
# maior parte das atualizações agora, por isso os ciclos ficaram mais longos
# (antes 30min/10min, quando o polling era o único mecanismo).
CATALOG_CACHE_TTL_MINUTES=360
STOCK_SYNC_INTERVAL_MINUTES=60

# ── Fluxo de pagamento (fechamento humano) ─────────────
# Número do funcionário que finaliza o pagamento, formato 55DDDNUMERO
ATENDENTE_PAGAMENTO_TELEFONE=

# ── IA na conversa do WhatsApp (opcional) ───────────────
# Camada de interpretação por linguagem natural por cima do menu numérico.
# OPCIONAL: deixe AI_ENABLED=false (ou apague as linhas) que o sistema
# continua funcionando 100% com o menu estático, sem exigir chave nenhuma.
AI_ENABLED=false
AI_PROVIDER=anthropic
# Chave da API da Anthropic (console.anthropic.com) — só necessária se
# AI_ENABLED=true.
AI_API_KEY=
AI_MODEL=claude-haiku-4-5

# ── Painel admin ────────────────────────────────────────
# Gere um valor aleatório forte (ex: openssl rand -hex 24) e mantenha em segredo.
# Enviado no header X-Admin-Key em toda chamada a /api/admin/* e /bling/sync*.
ADMIN_API_KEY=chave-de-teste-local

# ── CORS ─────────────────────────────────────────────────
# Domínios autorizados a chamar /api/*. Separe por vírgula.
# Deixe vazio em desenvolvimento para liberar tudo.
# Exemplo em produção: ALLOWED_ORIGINS=https://loja.com.br,https://www.loja.com.br
ALLOWED_ORIGINS=
